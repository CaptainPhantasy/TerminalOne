{
  "name": "terminalone",
  "version": "1.0.1",
  "description": "A browser-based terminal emulator \u2014 your shell, in your browser, with 39 feature modules and PWA install. Free. No subscription. No catch.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CaptainPhantasy/TerminalOne.git"
  },
  "homepage": "https://floyd-labs-proving-ground.captainphantasy.chatgpt.site/open-source",
  "bugs": {
    "url": "https://github.com/CaptainPhantasy/TerminalOne/issues"
  },
  "keywords": [
    "terminal",
    "emulator",
    "browser",
    "pty",
    "websocket",
    "xterm",
    "pwa",
    "shell"
  ],
  "main": "src/server.js",
  "packageManager": "npm@10.9.3",
  "scripts": {
    "start": "scripts/node-runtime.sh exec src/server.js",
    "dev": "scripts/node-runtime.sh exec src/server.js",
    "doctor": "scripts/node-runtime.sh doctor",
    "repair": "scripts/node-runtime.sh repair",
    "test": "npm run test:security && bash tests/hooks.test.sh && scripts/node-runtime.sh exec tests/input-guard.test.mjs && scripts/node-runtime.sh exec tests/smoke-test.js && scripts/node-runtime.sh exec tests/feature-test.js && scripts/node-runtime.sh exec tests/feature-behavior-test.js && scripts/node-runtime.sh exec tests/voice-input.test.js && scripts/node-runtime.sh exec tests/responsive-test.js",
    "test:unit": "scripts/node-runtime.sh exec tests/input-guard.test.mjs",
    "test:smoke": "scripts/node-runtime.sh exec tests/smoke-test.js",
    "test:features": "scripts/node-runtime.sh exec tests/feature-test.js",
    "test:behavior": "scripts/node-runtime.sh exec tests/feature-behavior-test.js",
    "test:voice": "scripts/node-runtime.sh exec tests/voice-input.test.js",
    "test:responsive": "scripts/node-runtime.sh exec tests/responsive-test.js",
    "postinstall": "sh scripts/prepare-native.sh",
    "test:security": "node --test tests/request-boundary.test.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^5.2.1",
    "node-pty": "^1.1.0",
    "uuid": "^14.0.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "puppeteer": "^25.3.0"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "files": [
    "src/",
    "public/",
    "scripts/node-runtime.sh",
    "scripts/prepare-native.sh",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "assets/",
    "npm-shrinkwrap.json"
  ],
  "author": "Floyd's Labs"
}
