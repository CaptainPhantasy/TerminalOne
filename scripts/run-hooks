#!/usr/bin/env python3
"""Run ordered Terminal Workspace lifecycle hooks with bounded execution."""

from __future__ import annotations

import json
import os
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path


def main() -> int:
    if len(sys.argv) < 2:
        print(f"usage: {sys.argv[0]} EVENT [--best-effort]", file=sys.stderr)
        return 64
    event = sys.argv[1]
    if not event.replace("-", "").replace("_", "").isalnum():
        print(f"invalid hook event: {event}", file=sys.stderr)
        return 64
    best_effort = "--best-effort" in sys.argv[2:]
    root = Path(__file__).resolve().parent.parent
    product = "terminalone"
    timeout = float(os.environ.get("TERMINAL_HOOK_TIMEOUT", "30"))
    hook_roots = [
        root / ".terminal-hooks" / f"{event}.d",
        Path.home() / ".config" / "terminal-workspace" / "hooks" / product / f"{event}.d",
    ]
    context = json.dumps({
        "schemaVersion": 1,
        "product": product,
        "event": event,
        "root": str(root),
        "pid": os.getpid(),
        "timestamp": datetime.now(timezone.utc).isoformat(),
    }) + "\n"
    env = os.environ | {
        "TERMINAL_HOOK_EVENT": event,
        "TERMINAL_PRODUCT": product,
        "TERMINAL_PRODUCT_ROOT": str(root),
    }
    failures = 0
    for directory in hook_roots:
        if not directory.is_dir():
            continue
        for hook in sorted(directory.iterdir()):
            if hook.name.startswith(".") or not hook.is_file():
                continue
            if not os.access(hook, os.X_OK):
                print(f"hook skipped (not executable): {hook}", file=sys.stderr)
                continue
            try:
                result = subprocess.run(
                    [str(hook)], input=context, text=True, env=env, timeout=timeout, check=False
                )
                if result.returncode:
                    failures += 1
                    print(f"hook failed ({result.returncode}): {hook}", file=sys.stderr)
            except subprocess.TimeoutExpired:
                failures += 1
                print(f"hook timed out after {timeout:g}s: {hook}", file=sys.stderr)
            if failures and not best_effort:
                return 70
    return 0 if not failures or best_effort else 70


if __name__ == "__main__":
    raise SystemExit(main())
